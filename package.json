{
  "name": "workerhub-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WorkerHub 首页/目录站（hub）：Cloudflare Workers 生态中文精选应用目录",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/fetch-github-meta.ts && tsx scripts/fetch-og-images.ts && astro build",
    "preview": "astro preview",
    "validate:data": "tsx scripts/validate-data.ts",
    "validate:submission": "tsx scripts/validate-submission.ts",
    "check:repos": "tsx scripts/validate-submission.ts --checks=repos",
    "check:links": "tsx scripts/validate-submission.ts --checks=links",
    "check:screenshots": "tsx scripts/validate-submission.ts --checks=screenshots",
    "check:pr-scope": "tsx scripts/check-pr-scope.ts",
    "fetch:meta": "tsx scripts/fetch-github-meta.ts",
    "lint": "pnpm lint:types && pnpm lint:format",
    "format": "prettier --write .",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint:types": "astro check",
    "lint:format": "prettier --check .",
    "fetch:og": "tsx scripts/fetch-og-images.ts",
    "health:links": "tsx scripts/link-health.ts",
    "summary:build": "tsx scripts/build-summary.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "image-size": "^2.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "wrangler": "4.153.0"
  }
}
