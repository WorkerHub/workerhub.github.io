---
/**
 * 占位页（S1-A 交付范围）：只证明「数据文件 → schema 校验 → 自动字段合并 → 静态产出」这条管线跑通。
 * 首页 Hero、官方区、卡片组件等正式 UI 由 S2-A 页面组件子单实现，本文件届时整份替换。
 */
import '../styles/global.css';
import { getBuildInfo } from '../lib/build-info';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const build = getBuildInfo();
const officialCount = projects.filter((project) => project.data.source === 'official').length;
const metaMissingCount = projects.filter((project) => project.meta.stargazersCount === null).length;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WorkerHub · 数据管线占位页</title>
    <meta
      name="description"
      content="WorkerHub 首页脚手架占位页：验证数据文件 schema 校验与 GitHub 自动字段合并管线。"
    />
    <link rel="canonical" href={canonical.href} />
  </head>
  <body class="min-h-screen">
    <main class="mx-auto max-w-4xl px-4 py-10">
      <h1 class="text-2xl font-bold">WorkerHub · 数据管线占位页</h1>
      <p class="mt-2 text-sm text-slate-600">
        这是 S1-A 脚手架占位页，用于证明 <code>pnpm build</code> 的数据管线可用；正式首页与组件由
        S2-A 实现。
      </p>

      <dl class="mt-6 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
        <div class="rounded border border-slate-200 bg-white p-3">
          <dt class="text-slate-500">项目总数</dt>
          <dd class="text-lg font-semibold">{projects.length}</dd>
        </div>
        <div class="rounded border border-slate-200 bg-white p-3">
          <dt class="text-slate-500">官方 / 第三方</dt>
          <dd class="text-lg font-semibold">
            {officialCount} / {projects.length - officialCount}
          </dd>
        </div>
        <div class="rounded border border-slate-200 bg-white p-3">
          <dt class="text-slate-500">自动字段缺失</dt>
          <dd class="text-lg font-semibold">{metaMissingCount}</dd>
        </div>
        <div class="rounded border border-slate-200 bg-white p-3">
          <dt class="text-slate-500">构建版本</dt>
          <dd class="text-lg font-semibold">{build.version}</dd>
        </div>
      </dl>

      {projects.length === 0 ? (
        <p class="mt-8 rounded border border-dashed border-slate-300 p-6 text-sm text-slate-600">
          当前数据目录没有任何项目文件。内容数据由 S1 内容子单提供，管线本身已就绪。
        </p>
      ) : (
        <table class="mt-8 w-full border-collapse text-left text-sm">
          <caption class="sr-only">项目数据与自动字段合并结果</caption>
          <thead>
            <tr class="border-b border-slate-300 text-slate-600">
              <th scope="col" class="py-2 pr-3">
                slug
              </th>
              <th scope="col" class="py-2 pr-3">
                来源 / 等级
              </th>
              <th scope="col" class="py-2 pr-3">
                分类
              </th>
              <th scope="col" class="py-2 pr-3">
                部署方式
              </th>
              <th scope="col" class="py-2 pr-3">
                stars
              </th>
              <th scope="col" class="py-2">
                最近更新
              </th>
            </tr>
          </thead>
          <tbody>
            {projects.map((project) => (
              <tr class="border-b border-slate-200">
                <td class="py-2 pr-3 font-mono">{project.slug}</td>
                <td class="py-2 pr-3">
                  {project.data.source} / {project.data.tier}
                </td>
                <td class="py-2 pr-3">{project.data.category}</td>
                <td class="py-2 pr-3">{project.data.deploy.method}</td>
                <td class="py-2 pr-3">{project.meta.stargazersCount ?? '—'}</td>
                <td class="py-2">{project.meta.pushedAt?.slice(0, 10) ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <p class="mt-8 text-xs text-slate-500">构建时间：{build.builtAt}</p>
    </main>
  </body>
</html>
