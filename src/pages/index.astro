---
/**
 * 首页（SPEC §2）：Hero（站名、一句话定位、搜索框、官方/第三方/总数统计）
 * + 官方项目区（置顶）+ 精选推荐位（第三方 ≤6）+ 分类快捷入口 + 最新收录（≤8）。
 *
 * 卡片一律用统一组件 `ProjectCard`（构建期渲染成静态 HTML，零 JS），
 * 搜索框是原生 GET 表单，直接把关键词带到 `/projects/?q=`，不需要额外 JS。
 */
import { ArrowRight, Search } from 'lucide-react';

import ProjectCard from '@/components/project/project-card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Input } from '@/components/ui/input';
import BaseLayout from '@/layouts/base-layout.astro';
import { getProjectViews, summariseCategories, summariseSite } from '@/lib/project-view';
import { sortProjects } from '@/lib/project-filter';
import { CATEGORY_DESCRIPTIONS, CATEGORY_LABELS } from '@/lib/project-types';
import { SITE } from '@/lib/site';

const views = await getProjectViews();
const stats = summariseSite(views);
const categories = summariseCategories(views);

// 官方区：置顶展示，coming-soon（waker 预告位）恒排末位（§3.1）
const official = views
  .filter((view) => view.source === 'official')
  .sort(
    (a, b) =>
      Number(a.status === 'coming-soon') - Number(b.status === 'coming-soon') ||
      a.name.localeCompare(b.name, 'zh-Hans-CN'),
  );

// 精选推荐位：仅第三方、featured，最多 6 个（§2）
const featured = sortProjects(
  views.filter((view) => view.source === 'third-party' && view.featured),
  'added',
).slice(0, 6);

// 最新收录：按收录日期倒序，最多 8 个（§2）
const latest = sortProjects(views, 'added').slice(0, 8);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="relative overflow-hidden border-b border-border">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_50%_-10%,var(--color-accent),transparent_70%)]"
    ></div>
    <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <Badge variant="outline" className="mb-4 border-border bg-background/60">
        Cloudflare Workers 生态 · 中文精选目录
      </Badge>
      <h1 class="max-w-3xl text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">
        可自部署的 Cloudflare Workers 应用，一处找齐
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg">
        官方自研项目 + 经收录把关的第三方开源项目。每个条目都标清
        <b class="text-foreground">部署方式、所需资源、难度、免费层与验证等级</b>
        ，从卡片直达仓库与部署入口，把项目部署到你自己的 Cloudflare 账户。
      </p>

      <form action="/projects/" method="get" role="search" class="mt-7 flex max-w-xl gap-2">
        <div class="relative flex-1">
          <label for="home-search" class="sr-only">
            搜索项目
          </label>
          <Search
            aria-hidden="true"
            className="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground"
          />
          <Input
            id="home-search"
            type="search"
            name="q"
            placeholder="搜索名称、介绍、标签（如邮箱、监控、D1）"
            autoComplete="off"
            className="h-10 pl-9"
          />
        </div>
        <Button type="submit" size="lg">
          搜索
          <ArrowRight aria-hidden="true" />
        </Button>
      </form>

      <dl class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm">
        <div class="flex items-baseline gap-2">
          <dt class="text-muted-foreground">官方项目</dt>
          <dd class="text-xl font-semibold tabular-nums">{stats.official}</dd>
        </div>
        <div class="flex items-baseline gap-2">
          <dt class="text-muted-foreground">第三方项目</dt>
          <dd class="text-xl font-semibold tabular-nums">{stats.thirdParty}</dd>
        </div>
        <div class="flex items-baseline gap-2">
          <dt class="text-muted-foreground">收录总数</dt>
          <dd class="text-xl font-semibold tabular-nums">{stats.total}</dd>
        </div>
      </dl>
      <p class="mt-4">
        <a
          href="/projects/"
          class="inline-flex items-center gap-1 text-sm font-medium underline-offset-4 hover:underline"
        >
          浏览全部项目
          <ArrowRight aria-hidden="true" className="size-3.5" />
        </a>
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-14 sm:px-6" aria-labelledby="official-heading">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="official-heading" class="text-2xl font-semibold tracking-tight">
          官方项目
        </h2>
        <p class="mt-1 text-sm text-muted-foreground">
          WorkerHub 自研项目，由我们自己维护与部署；金色徽章 = 官方。
        </p>
      </div>
      <a
        href="/projects/?src=official"
        class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
      >
        只看官方
        <ArrowRight aria-hidden="true" className="size-3.5" />
      </a>
    </div>
    <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {official.map((project) => (
        <li class="h-full">
          <ProjectCard project={project} />
        </li>
      ))}
    </ul>
  </section>

  {featured.length > 0 && (
    <section class="mx-auto w-full max-w-6xl px-4 pt-14 sm:px-6" aria-labelledby="featured-heading">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="featured-heading" class="text-2xl font-semibold tracking-tight">
            精选推荐
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">
            编辑人工挑选的第三方项目，适合第一次自部署上手。
          </p>
        </div>
        <a
          href="/projects/?src=third-party"
          class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
        >
          只看第三方
          <ArrowRight aria-hidden="true" className="size-3.5" />
        </a>
      </div>
      <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {featured.map((project) => (
          <li class="h-full">
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mx-auto w-full max-w-6xl px-4 pt-14 sm:px-6" aria-labelledby="category-heading">
    <h2 id="category-heading" class="text-2xl font-semibold tracking-tight">
      按分类浏览
    </h2>
    <p class="mt-1 text-sm text-muted-foreground">分类下同样支持搜索、六维筛选与排序。</p>
    <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((category) => (
        <li>
          <a
            href={`/categories/${category.slug}/`}
            class="group flex h-full flex-col gap-1 rounded-xl border border-border bg-card p-4 shadow-xs transition-shadow hover:shadow-md"
          >
            <span class="flex items-center justify-between gap-2">
              <span class="font-medium">{CATEGORY_LABELS[category.slug]}</span>
              <span class="text-xs text-muted-foreground tabular-nums">{category.count} 个</span>
            </span>
            <span class="text-sm text-muted-foreground">
              {CATEGORY_DESCRIPTIONS[category.slug]}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-14 sm:px-6" aria-labelledby="latest-heading">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="latest-heading" class="text-2xl font-semibold tracking-tight">
          最新收录
        </h2>
        <p class="mt-1 text-sm text-muted-foreground">按收录日期倒序，展示最近上架的项目。</p>
      </div>
      <a
        href="/projects/?sort=added"
        class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
      >
        查看全部
        <ArrowRight aria-hidden="true" className="size-3.5" />
      </a>
    </div>
    <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {latest.map((project) => (
        <li class="h-full">
          <ProjectCard project={project} />
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto mt-16 w-full max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col gap-4 rounded-2xl border border-border bg-muted/40 p-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-semibold">有想收录的项目？</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          投稿就是一个只新增数据文件的 PR：收录标准、字段说明与验证等级都写在提交收录页。
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <Button asChild>
          <a href="/submit/">提交收录</a>
        </Button>
        <Button asChild variant="outline">
          <a href="/about/">了解验证等级</a>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
